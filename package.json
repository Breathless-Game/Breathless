{
  "name": "deepbreath",
  "private": true,
  "scripts": {
    "sensor": "npm --prefix sensor start",
    "sensor:sim": "npm --prefix sensor run sim",
    "market": "npm --prefix sensor run market",
    "game": "npm --prefix game run dev",
    "dev": "node scripts/dev.mjs",
    "showcase:gif": "node scripts/capture-showcase.mjs",
    "setup": "npm --prefix sensor install && npm --prefix game install",
    "build": "npm --prefix game run build",
    "test": "npm --prefix game test && npm --prefix sensor test",
    "start": "node sensor/index.mjs --serve game/dist"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/mpl-toolbox": "0.11.5",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@upstash/redis": "1.39.0",
    "@vercel/functions": "3.9.9"
  }
}
