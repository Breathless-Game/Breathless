# /etc/sudoers.d/breathless (mode 0440): lets the deploy job, running as the
# `breathless` user, restart and inspect its own service and nothing else.
# Installed by deploy/bootstrap-dell.sh after `visudo -cf`.
#
# Arguments are pinned on purpose, with no wildcards: journalctl with free
# arguments could read other services' logs, and without --no-pager its pager
# (less) can open a root shell.
Cmnd_Alias BREATHLESS_SERVICE = /usr/bin/systemctl restart breathless, \
                                /usr/bin/systemctl is-active breathless, \
                                /usr/bin/journalctl -u breathless -n 50 --no-pager
breathless ALL=(root) NOPASSWD: BREATHLESS_SERVICE
