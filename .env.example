# Presage SmartSpectra key: https://physiology.presagetech.com/portal/dashboard
PRESAGE_API_KEY=
SENSOR_PORT=8787
# PEARL market (sensor/market.mjs). Dev: `npm run market` on MARKET_PORT=8795, which Vite proxies;
# `npm start` serves it itself at /api/market on PORT.
# Empty = server mode (fallback). Set to the deployed fish_market program id for program mode.
FISH_MARKET_PROGRAM_ID=
# Oracle keypair for program mode, relative to the repo root (created if missing).
# MARKET_ORACLE_KEYPAIR=sensor/.market-oracle.json
# Folder for the market's keypair and state, relative to the repo root (default: sensor).
# MARKET_DIR=sensor

# Serve mode only (`npm start`); see README "Self-hosting"
# PORT=8794
# HOST=127.0.0.1
# MAX_LIVE_SESSIONS=1
# MAX_CONN_PER_IP=8
# SENSOR_RECORD=1
